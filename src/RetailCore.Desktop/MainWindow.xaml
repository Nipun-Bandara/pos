<Window x:Class="RetailCore.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Width="1280" Height="850" MinWidth="800" MinHeight="600"
 FontFamily="{StaticResource PosFont}" FontSize="14"
 Foreground="{DynamicResource PosInk}" Background="{DynamicResource PosBackground}"
 WindowStartupLocation="Manual" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 AllowsTransparency="False" SizeToContent="Manual" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="_header" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,0,0,1" Padding="16,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
     <TextBlock x:Name="_appTitle" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
     <TextBlock x:Name="_currentUser" Foreground="{DynamicResource PosMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="420">
     <ContentControl x:Name="_languageSlot" MinWidth="100" Margin="0,0,8,0"/>
     <Button x:Name="_themeToggle" Width="36" MinWidth="36" Padding="0" ContentTemplate="{x:Null}" AutomationProperties.AutomationId="ThemeToggle" Click="ThemeClicked">
      <md:PackIcon Kind="ThemeLightDark" Width="20" Height="20"/>
     </Button>
     <Button x:Name="_lockButton" Tag="Lock" AutomationProperties.AutomationId="Lock" Click="LockClicked"/>
     <Button x:Name="_signOutButton" Tag="SignOut" AutomationProperties.AutomationId="SignOut" Click="SignOutClicked"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="_nav" Width="136" Padding="8,12" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,0,1,0">
    <StackPanel x:Name="_navigation">
     <Button Tag="Billing" AutomationProperties.AutomationId="Billing" Click="NavigateClicked"/>
     <Button Tag="Products" AutomationProperties.AutomationId="Products" Click="NavigateClicked"/>
     <Button Tag="Stock" AutomationProperties.AutomationId="Stock" Click="NavigateClicked"/>
     <Button Tag="Returns" AutomationProperties.AutomationId="Returns" Click="NavigateClicked"/>
     <Button Tag="Reports" AutomationProperties.AutomationId="Reports" Click="NavigateClicked"/>
     <Button Tag="Settings" AutomationProperties.AutomationId="Settings" Click="NavigateClicked"/>
    </StackPanel>
   </Border>
   <Grid Grid.Column="1" Margin="{StaticResource PosPagePadding}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="_sectionTitle" Style="{StaticResource PosPageTitle}"/>
    <ContentControl x:Name="_body" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource PosSurface}" BorderBrush="{DynamicResource PosBorder}" BorderThickness="0,1,0,0" Padding="16,6">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="_status" TextWrapping="Wrap" Foreground="{DynamicResource PosError}" AutomationProperties.AutomationId="ApplicationStatus" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="_backupHealth" Grid.Column="1" MaxWidth="320" Margin="12,0,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PosMuted}" AutomationProperties.AutomationId="BackupHealth"/>
   </Grid>
  </Border>
 </Grid>
</Window>
