<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <SolidColorBrush x:Key="PosBackground" Color="#F6F7F9"/>
 <SolidColorBrush x:Key="PosSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="PosInk" Color="#172033"/>
 <SolidColorBrush x:Key="PosMuted" Color="#526077"/>
 <SolidColorBrush x:Key="PosBorder" Color="#D8DEE8"/>
 <SolidColorBrush x:Key="PosAccent" Color="#1D4ED8"/>
 <SolidColorBrush x:Key="PosAccentSoft" Color="#EBF1FF"/>
 <SolidColorBrush x:Key="PosError" Color="#B42318"/>
 <FontFamily x:Key="PosFont">Nirmala UI, Segoe UI, Iskoola Pota</FontFamily>
 <Thickness x:Key="PosPagePadding">16,12</Thickness>
 <Thickness x:Key="PosFieldGap">0,4,0,8</Thickness>
 <Style x:Key="PosFocus">
  <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
   <Rectangle Margin="-3" Stroke="{StaticResource PosAccent}" StrokeThickness="2" StrokeDashArray="2,1" RadiusX="4" RadiusY="4"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PosButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
  <Setter Property="Foreground" Value="{StaticResource PosInk}"/>
  <Setter Property="Background" Value="{StaticResource PosSurface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource PosBorder}"/>
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="Padding" Value="12,7"/>
  <Setter Property="Margin" Value="0,4,8,4"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Height" Value="Auto"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
  <Setter Property="md:RippleAssist.IsDisabled" Value="True"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
   <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
  </DataTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource PosButton}"/>
 <Style x:Key="PosPrimaryButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
  <Setter Property="Background" Value="{StaticResource PosAccent}"/>
  <Setter Property="BorderBrush" Value="{StaticResource PosAccent}"/>
  <Setter Property="Foreground" Value="White"/>
 </Style>
 <Style x:Key="PosNavButton" TargetType="Button" BasedOn="{StaticResource PosButton}">
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Margin" Value="0,2"/>
  <Setter Property="MinHeight" Value="44"/>
 </Style>
 <Style x:Key="PosSelectedNavButton" TargetType="Button" BasedOn="{StaticResource PosNavButton}">
  <Setter Property="Background" Value="{StaticResource PosAccentSoft}"/>
  <Setter Property="Foreground" Value="{StaticResource PosAccent}"/>
 </Style>
 <Style x:Key="PosInput" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="Padding" Value="9,7"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Margin" Value="{StaticResource PosFieldGap}"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
  <Setter Property="md:TextFieldAssist.HasClearButton" Value="False"/>
 </Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource PosInput}"/>
 <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="Padding" Value="9,7"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Margin" Value="{StaticResource PosFieldGap}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="Padding" Value="9,7"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Margin" Value="{StaticResource PosFieldGap}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
 </Style>
 <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
  <Setter Property="Margin" Value="0,6,8,6"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PosTable" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="Background" Value="{StaticResource PosSurface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource PosBorder}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PosBorder}"/>
  <Setter Property="RowHeaderWidth" Value="0"/>
  <Setter Property="MinRowHeight" Value="40"/>
  <Setter Property="ColumnHeaderHeight" Value="Auto"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="EnableRowVirtualization" Value="True"/>
  <Setter Property="EnableColumnVirtualization" Value="True"/>
  <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocus}"/>
 </Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource PosTable}"/>
 <!-- PosWrappedCell supplies basket text padding. Do not also inherit the
      Material cell's 16,8 padding: narrow columns wrap excessively at 800x600. -->
 <Style x:Key="PosBillingBasket" TargetType="DataGrid" BasedOn="{StaticResource PosTable}">
  <Setter Property="md:DataGridAssist.CellPadding" Value="0"/>
 </Style>
 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
  <Setter Property="Padding" Value="8,9"/>
  <Setter Property="Foreground" Value="{StaticResource PosMuted}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PosPageTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,12"/>
 </Style>
 <Style x:Key="PosSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource PosPageTitle}">
  <Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,16,0,8"/>
 </Style>
 <Style x:Key="PosSurfaceBorder" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource PosSurface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource PosBorder}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
  <Setter Property="Padding" Value="16"/>
 </Style>
 <Style x:Key="PosWrappedCell" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource PosFont}"/>
  <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="6,5"/>
 </Style>
</ResourceDictionary>
